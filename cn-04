
#include <iostream>
using namespace std;

#define INF 999

int main() {
    int n;
    int cost[10][10], dist[10][10], nextHop[10][10];

    cout << "Enter number of routers: ";
    cin >> n;

    cout << "Enter cost matrix (999 for no link):\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];
            dist[i][j] = cost[i][j];

            if (i == j)
                nextHop[i][j] = i;
            else if (cost[i][j] != INF)
                nextHop[i][j] = j;
            else
                nextHop[i][j] = -1;
        }
    }

    // Distance Vector Routing
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (dist[i][k] != INF && dist[k][j] != INF &&
                    dist[i][k] + dist[k][j] < dist[i][j]) {

                    dist[i][j] = dist[i][k] + dist[k][j];
                    nextHop[i][j] = nextHop[i][k];
                }
            }
        }
    }

    cout << "\nShortest Distance and Next Hop:\n";

    for (int i = 0; i < n; i++) {
        cout << "\nRouter " << i << ":\n";
        cout << "Destination\tDistance\tNext Hop\n";

        for (int j = 0; j < n; j++) {
            cout << j << "\t\t";

            if (dist[i][j] == INF)
                cout << "INF\t\t";
            else
                cout << dist[i][j] << "\t\t";

            if (nextHop[i][j] == -1)
                cout << "-";
            else
                cout << nextHop[i][j];

            cout << endl;
        }
    }

    return 0;
}
